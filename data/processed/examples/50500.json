no": "124", "start": "432.679", "end": "449.969", "research_region_id": "787", "region": "경상북도 상주시 공성면", "year": "2005", "sido": "경상북도", "sigungu": "상주시", "region_id": "75", "audio": "담화6", "trs_file": "SGB_SJ_06.trs", "lng": 128.067656439, "lat": 36.432280013, "informant": {"sex": "여성", "age": "75", "job": "농업"}, "no": 11}, {"route": "narrative", "variant": "파리", "matched_key": "파리", "is_standard": true, "speaker": "제보자", "dialect": "크래 가'주 은제, 그래 가주 하나'늗 여꾸'리 이자 하더'인 여: 차'고, 파리'이 오'머 여'페 사'르 차 흐'은치 주'고 또 히:고, 그'란다.", "standard": "그래 가지고 인제, 그래 가지고 하나는 옆구리 이래 하던지 여기 차고, 파리가 오면 옆의 사람 착 쫓아 주고 또 하고, 그런다.", "topic": "생업 활동", "subtopic": "논농사", "question": "벼농사를 짓는 과정에 대해 이야기해 주십시오.", "trs_id": "562", "line_no": "188", "start": "551.377", "end": "563.852", "research_region_id": "923", "region": "경상북도 의성군 봉양면", "year": "2009", "sido": "경상북도", "sigungu": "의성군", "region_id": "74", "audio": "SGBES029", "trs_file": "SGB_ES_29.trs", "lng": 128.615982426, "lat": 36.3647482703, "informant": {"sex": "남성", "age": "79", "job": "농업"}, "no": 12}, {"route": "narrative", "variant": "파레이", "matched_key": "파레이", "is_standard": false, "speaker": "제보자", "dialect": "고데로 고마 모 고마 키도 앙 크고 머 고데로 가고 페 올라뿌~이 이스 이사꺼리도 어꼬, 머 똑 파레이 대 그텀 갈라나낭 고래.", "standard": "그대로 고만 키도 안 크고 뭐 그대로 펴서 올라오니까, 이삭거리도 없고, 뭐 파리 대같이 갈라 놓은 것처럼 그래.", "topic": "생업 활동", "subtopic": "논농사", "question": "벼농사를 짓는 과정에 대해 이야기해 주십시오.", "trs_id": "459", "line_no": "1398", "start": "4075.850", "end": "4086.007", "research_region_id": "821", "region": "경상북도 청송군 진보면", "year": "2006", "sido": "경상북도", "sigungu": "청송군", "region_id": "82", "audio": "SGB_CS_02", "trs_file": "SGB_CS_02.trs", "lng": 129.058184055, "lat": 36.3599794765, "informant": {"sex": "남성", "age": "72", "job": "농업"}, "no": 13}, {"route": "narrative", "variant": "파리", "matched_key": "파리", "is_standard": true, "speaker": "제보자", "dialect": "그러니까 마라자믄 수:심년 한 배겨년 되는 거슨 파리가 똥을 싸서 포리 먼 파리뙹이 까카:마니 머라자믄 뚜꾸까이 생게 부러써. 막 그거 마라자믄 거머 거:머니 걍 머 먼 멘:년 면년 머 심년 이심년 멈머 한 팔구심년썩 요런 마라자믄 집뜰 보머는 메한: 메:씸년 파리한차 쌘논 노무거 주기도 모던 그런 세상인디. 얼:매나 파리똥이 싸 쌔야쓰꺼여", "standard": "그러니까 말하자면 수십 년 한 백여 년 되는 것은 파리가 똥을 싸서, 파리 무슨 파리똥이 까맣게 말하자면 두껍게 생겨 버렸어. 막 그거 말하자면 검게 그냥 몇 년, 몇 년, 뭐 십 년 이십 년 뭐뭐 한 팔구십 년씩 이런 말하자면 집들 보면은 몇 십년 파리조차 많은 놈의 것, 죽이지도 못하는 그런 세상인데, 얼마나 파리똥이 쌓였을 것이야.", "topic": "거주 생활", "subtopic": "집 짓기", "question": "집터를 다지면서 부르는 노래가 있으면 불러주십시오.", "trs_id": "922", "line_no": "316", "start": "2078.086", "end": "2103.763", "research_region_id": "1270", "region": "전라남도 곡성군 목사동면", "year": "2005", "sido": "전라남도", "sigungu": "곡성군", "region_id": "27", "audio": "SJN_GS_23", "trs_file": "SJN_GS_23.trs", "lng": 127.264449484, "lat": 35.2194399215, "informant": {"sex": "여성", "age": "71", "job": "농업"}, "no": 14}, {"route": "narrative", "variant": "파리", "matched_key": "파리", "is_standard": true, "speaker": "조사자", "dialect": "참 파리가 그러케 ***", "standard": "참 파리가 그렇게 ***.", "topic": "거주 생활", "subtopic": "집 짓기", "question": "집터를 다지면서 부르는 노래가 있으면 불러주십시오.", "trs_id": "922", "line_no": "320", "start": "2123.135", "end": "2128.520", "research_region_id": "1270", "region": "전라남도 곡성군 목사동면", "year": "2005", "sido": "전라남도", "sigungu": "곡성군", "region_id": "27", "audio": "SJN_GS_23", "trs_file": "SJN_GS_23.trs", "lng": 127.264449484, "lat": 35.2194399215, "informant": {"sex": "여성", "age": "71", "job": "농업"}, "no": 15}, {"route": "narrative", "variant": "포리", "matched_key": "포리", "is_standard": false, "speaker": "제보자", "dialect": "포리마너니 요마너니 꺼믕거이 여가 딱 무더부요.", "standard": "파리만하게 이만하게 까만 것이 여기에 딱 묻어버려요", "topic": "의생활", "subtopic": "누에치기와 비단 짜기", "question": "비단 짜는 기구(베틀)의 부분 명칭과 각각의 사용법에 대하여 이야기해 주십시오.", "trs_id": "920", "line_no": "1080", "start": "3276.552", "end": "3279.416", "research_region_id": "1268", "region": "전라남도 곡성군 목사동면", "year": "2005", "sido": "전라남도", "sigungu": "곡성군", "region_id": "27", "audio": "SJN_GS_22", "trs_file": "SJN_GS_22.trs", "lng": 127.264449484, "lat": 35.2194399215, "informant": {"sex": "여성", "age": "71", "job": "농업"}, "no": 16}, {"route": "narrative", "variant": "파리", "m