}, "no": 22}, {"route": "narrative", "variant": "바위", "matched_key": "바위", "is_standard": true, "speaker": "제보자", "dialect": "나는 바위 쇵펴니라고 솜씨가 업써가지고 똥그라케 맨드러서 요로케 요로케 요로케 좀 살지버서 그걸 잘 맨드러요.", "standard": "나는 바위 송편이라고 솜씨가 없어가지고 동그랗게 만들어서 요렇게, 요렇게, 요렇게 좀 살 집어서 그걸 잘 만들어요.", "topic": "식생활", "subtopic": "밑반찬의 조리", "question": "이 지역에서 주로 해 먹는 부식(반찬)을 만드는 재료와 조리 방법에 대하여 자세히 이야기해 주십시오.", "trs_id": "719", "line_no": "1848", "start": "3398.768", "end": "3408.285", "research_region_id": "1093", "region": "충청남도 예산군 대흥면", "year": "2008", "sido": "충청남도", "sigungu": "예산군", "region_id": "94", "audio": "10510-10520", "trs_file": "SCN_YS_10.trs", "lng": 126.784916845, "lat": 36.6732195006, "informant": {"sex": "남성", "age": "84", "job": "농업"}, "no": 23}, {"route": "narrative", "variant": "바우", "matched_key": "바우", "is_standard": false, "speaker": "제보자", "dialect": "바우두 이 너푼 바우 큰: 바우애 이개 허리가 저길 동아주럴 매:구서루 이러캐서 그 부치서 따능 건대 그거 따다 주근 사라미 마:나요, 그 서기버서시라능 기.", "standard": "바위도 그 높은 바위 큰 바위에 이게 허리에 저기를 동아줄을 매구서 이렇게 해서 그 붙여서 따는 건데 그거 따다가 죽은 사람이 많아요, 그 석이버섯이라는 게.", "topic": "일생 의례", "subtopic": "전통 혼례식", "question": "전통 혼례식 때는 주로 어떤 음식을 준비합니까?", "trs_id": "657", "line_no": "658", "start": "972.813", "end": "982.091", "research_region_id": "1014", "region": "충청북도 보은군 보은읍 종곡리", "year": "2009", "sido": "충청북도", "sigungu": "보은군", "region_id": "100", "audio": "SCB_BE_04 16k", "trs_file": "SCB_BE_04.trs", "lng": 127.730217597, "lat": 36.4927860733, "informant": {"sex": "남성", "age": "85", "job": "농업"}, "no": 24}], "survey": [{"route": "survey", "item_no": "23117", "dialect": "바위치기", "standard": "", "trs_id": "58", "line_no": "1198", "start": "5968.191", "end": "5969.188", "research_region_id": "2927", "region": "경기도 화성시 우정읍", "year": "2005", "sido": "경기도", "sigungu": "화성시", "region_id": "111", "audio": "SGG_HS_15(어휘8)", "trs_file": "SGG_HS_15.trs", "lng": 126.873634112, "lat": 37.1683411177}, {"route": "survey", "item_no": "23117-0-2", "dialect": "바위에 걸터안는다", "standard": "", "trs_id": "58", "line_no": "