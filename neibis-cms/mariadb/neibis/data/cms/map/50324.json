{"detail":{"ok":true,"data":{"headwordId":"1561","headwordNo":"50324","topicId":"121","headword":"모레","wordClass":"명사","meaning":"「001」내일의 다음 날.","commentary":"  ‘모레’의 방언형은 다음과 같이 크게 둘로 나뉜다.\r\n\r\n① ‘모레’계: 모레, 모례, 모래, 낼모레\r\n② 모리\r\n\r\n  하지만 역사적 기원을 고려하면 이들은 사실상 모두 한 계열에 속한다. 즉 17세기 문헌에 나타나는 어형 ‘모ᄅᆡ’(16세기에는 ‘모뢰’)에서 ‘ᄋᆡ>에’의 변화를 겪은 것이 ‘모레’고, ‘ᄋᆡ>애’의 변화를 겪은 것이 ‘모래’, 그리고 ‘ᄋᆡ>의’의 변화를 겪은 것이 ‘모리’다. ‘모레’와 ‘모래’는, 한국의 전 지역 방언에서 폭넓게 일어난 ‘에’와 ‘애’의 합류와 관련된 형태일 수도 있으며 ‘모리’는 틀림없이 자음 뒤 ‘의>이’의 변화를 겪은 형태다. ‘모리’가 충청남도와 그 인근 지역 그리고 제주도에 집중적으로 나타난다는 점도 방언 분포상 특징적이라 할 만하다.","usid":"map05","useYn":"Y","appro":"N","mapMake":"Y","createDt":"-"}},"dialect":{"ok":true,"headwordNo":"50324","total":7,"list":[{"hdId":"13046","headwordNo":"50324","word":"모레","faceColor":"255, 0, 0","mutationGroup":"1","mutationSeq":"1","mapSymbolId":"1","symbolColor":"FF0000","regionCount":134,"regions":[{"hdrId":"80992","regionNm":"강원도 고성군","regionId":"128","mapKey":"고성군","sido":"강원도"},{"hdrId":"80993","regionNm":"강원도 동해시","regionId":"248","mapKey":"동해시","sido":"강원도"},{"hdrId":"80994","regionNm":"강원도 삼척시","regionId":"131","mapKey":"삼척시","sido":"강원도"},{"hdrId":"80995","regionNm":"강원도 속초시","regionId":"246","mapKey":"속초시","sido":"강원도"},{"hdrId":"80996","regionNm":"강원도 양구군","regionId":"140","mapKey":"양구군","sido":"강원도"},{"hdrId":"80997","regionNm":"강원도 양양군","regionId":"129","mapKey":"양양군","sido":"강원도"},{"hdrId":"80998","regionNm":"강원도 영월군","regionId":"133","mapKey":"영월군","sido":"강원도"},{"hdrId":"80999","regionNm":"강원도 원주시","regionId":"135","mapKey":"원주시","sido":"강원도"},{"hdrId":"81001","regionNm":"강원도 인제군","regionId":"141","mapKey":"인제군","sido":"강원도"},{"hdrId":"81002","regionNm":"강원도 정선군","regionId":"132","mapKey":"정선군","sido":"강원도"},{"hdrId":"81003","regionNm":"강원도 철원군","regionId":"142","mapKey":"철원군","sido":"강원도"},{"hdrId":"81004","regionNm":"강원도 춘천시","regionId":"138","mapKey":"춘천시","sido":"강원도"},{"hdrId":"81005","regionNm":"강원도 태백시","regionId":"247","mapKey":"태백시","sido":"강원도"},{"hdrId":"81006","regionNm":"강원도 평창군